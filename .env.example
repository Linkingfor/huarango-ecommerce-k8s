# Variables del entorno local (docker compose). Copia este archivo a .env y cambia las contraseñas.
# El archivo .env no se sube al repositorio (.gitignore). En AWS estos valores viven en Secrets Manager.

# Contraseña del usuario administrador de PostgreSQL
PG_ADMIN_PASSWORD=cambia-esta-clave-admin

# Una contraseña por servicio: cada uno entra a la base con su propio usuario y solo ve su esquema
DB_PW_USUARIOS=cambia-clave-usuarios
DB_PW_CATALOGO=cambia-clave-catalogo
DB_PW_ORDENES=cambia-clave-ordenes

# Cuenta de administrador de la tienda (se crea al arrancar svc-usuarios)
ADMIN_EMAIL=admin@huarango.pe
ADMIN_PASSWORD=cambia-clave-admin-tienda1

# Remitente de los correos
MAIL_FROM=Huarango Market <pedidos@huarango.pe>

# Secreto para validar el webhook de la pasarela de pagos
WEBHOOK_SECRET=cambia-este-secreto

# Pasarela: "simulado" (por defecto) o "culqi" con la llave de pruebas sk_test_...
PASARELA_MODO=simulado
CULQI_SECRET_KEY=
